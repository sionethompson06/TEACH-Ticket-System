# TEACH Ticket System — .gitignore
# These patterns prevent accidental commits of secrets and local/build artifacts.

# Environment / secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Framework / build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Test coverage
coverage/

# Deployment
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE temporary files
.vscode/
.idea/
*.swp
*.swo
*~
