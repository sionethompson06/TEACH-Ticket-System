# TEACH Ticket System — preliminary .gitignore
# This is preliminary: no application has been scaffolded yet (see docs/PHASE_PLAN.md).
# These patterns exist to prevent accidental commits of secrets and local/build artifacts
# once later phases introduce them.

# Environment / secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Framework / build output
.next/
out/
dist/
build/

# Test coverage
coverage/

# Deployment
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE temporary files
.vscode/
.idea/
*.swp
*.swo
*~
